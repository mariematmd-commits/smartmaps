# Copy to client/.env and fill in. Never commit client/.env.
#
# Google Maps JavaScript API key used in the BROWSER to draw the map.
# This key is visible in the page, which is normal — restrict it by HTTP
# referrer (your domain / localhost) in the Google Cloud console.
# It can be the same key as the server one during local dev, or a separate
# browser-restricted key for production.
VITE_GOOGLE_MAPS_API_KEY=
